<% const items = Array.isArray(page.items) ? page.items : []; %>
<% const published = items.map(item => ({ title: item.title, character: item.character, name_en: item.name_en, series: item.series, artist: item.artist, source_url: item.source_url, artist_url: item.artist_url, alt: item.alt, note: item.note, width: item.width, height: item.height, image: /^https?:\/\//i.test(item.image) ? item.image : url_for(item.image) })); %>
<section class="gallery-page" data-gallery-page>
  <header class="archive-header">
    <p class="eyebrow"><%= page.eyebrow || 'AEMEATH GALLERY' %></p>
    <h1><%= page.title || '爱弥斯画廊' %></h1>
    <% if (page.description) { %><p><%= page.description %></p><% } %>
    <p class="gallery-count">共 <%= published.length %> 张</p>
  </header>
  <% if (published.length) { %>
  <div class="gallery-grid">
    <% published.forEach(function(item, index) { %>
    <article class="gallery-frame glass">
      <a class="gallery-open" href="<%= item.source_url || item.image %>" target="_blank" rel="noopener noreferrer" data-gallery-open="<%= index %>" aria-label="查看《<%= item.title || item.character %>》">
        <img src="<%= item.image %>" alt="<%= item.alt %>"<% if (item.width) { %> width="<%= item.width %>"<% } %><% if (item.height) { %> height="<%= item.height %>"<% } %> loading="lazy">
      </a>
      <div class="gallery-meta">
        <h2><%= item.title ? '《' + item.title + '》' : item.character %></h2>
        <p><% if (item.artist_url) { %><a href="<%= item.artist_url %>" target="_blank" rel="noopener noreferrer"><%= item.artist || '画师' %> ↗</a><% } else { %><%= item.artist %><% } %><% if (item.series) { %> · <%= item.series %><% } %></p>
        <% if (item.note) { %><p class="gallery-note"><%= item.note %></p><% } %>
      </div>
    </article>
    <% }); %>
  </div>
  <dialog class="gallery-lightbox" data-gallery-dialog aria-labelledby="gallery-lightbox-title">
    <button type="button" data-gallery-close aria-label="关闭画廊">✕</button>
    <div class="gallery-lightbox-stage">
      <button type="button" data-gallery-prev aria-label="上一张">‹</button>
      <img data-gallery-image alt="">
      <button type="button" data-gallery-next aria-label="下一张">›</button>
    </div>
    <div class="gallery-lightbox-copy">
      <h2 id="gallery-lightbox-title" data-gallery-title></h2>
      <p data-gallery-credit></p>
      <p class="gallery-lightbox-links"><a data-gallery-source href="" target="_blank" rel="noopener noreferrer">在 Pixiv 查看原作 ↗</a><a data-gallery-artist href="" target="_blank" rel="noopener noreferrer">画师主页 ↗</a></p>
      <p data-gallery-note></p>
    </div>
  </dialog>
  <script type="application/json" id="gallery-data"><%- JSON.stringify(published).replace(/</g, '\\u003c') %></script>
  <% } else { %>
  <p class="empty-state">画廊还空着。喜欢的插画，会一张张收进来。</p>
  <% } %>
  <p class="gallery-credit">插画版权归原画师所有。画面及角色与作品官方没有关联，仅作个人欣赏与署名展示。</p>
</section>
