<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% const currentTitle = is_home() ? config.title : ((page.title || (is_archive() ? '文章归档' : config.title)) + ' · ' + config.title); %>
  <% const summary = page.description || config.description; %>
  <title><%= currentTitle %></title>
  <meta name="description" content="<%= summary %>">
  <meta name="author" content="<%= config.author %>">
  <% if (config.build_commit) { %><meta name="build-commit" content="<%= config.build_commit %>"><% } %>
  <meta name="theme-color" content="#f4eef8">
  <meta name="color-scheme" content="light">
  <% if (config.preview_build || page.path === '404.html') { %><meta name="robots" content="noindex, nofollow"><% } %>
  <link rel="canonical" href="<%= full_url_for(page.path || '') %>">
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= currentTitle %>">
  <meta property="og:description" content="<%= summary %>">
  <meta property="og:url" content="<%= full_url_for(page.path || '') %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:locale" content="zh_CN">
  <link rel="icon" type="image/svg+xml" href="<%= url_for('/favicon.svg') %>">
  <link rel="preconnect" href="https://fonts.googleapis.cn" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.cn/css2?family=Noto+Sans+SC:wght@400;500;600;700&amp;display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.cn/css2?family=Noto+Sans+SC:wght@400;500;600;700&amp;display=swap"></noscript>
  <link rel="stylesheet" href="<%= url_for('/css/style.css') %>">
  <style>:root{<%- desktop_palette() %>}</style>
  <script>
    function readJournalMood() {
      try { return (<%- journal_mood_parser() %>)(localStorage.getItem('duluo:mood')); } catch { return null; }
    }
    function restoreJournalMood() {
      readJournalMood()?.forEach((color, i) => document.documentElement.style.setProperty('--mood-' + (i + 1), color));
    }
    restoreJournalMood();
    window.addEventListener('pageshow', event => { if (event.persisted) restoreJournalMood(); });
  </script>
  <script src="<%= url_for('/js/site.js') %>" defer></script>
  <script src="<%= url_for('/js/motion.js') %>" defer></script>
  <% if (is_home()) { %><script src="<%= url_for('/js/desktop.js') %>" defer></script><% } %>
  <% if (page.path === 'share/index.html') { %><script src="<%= url_for('/js/share.js') %>" defer></script><% } %>
  <% if (page.path === 'gallery/index.html') { %><script src="<%= url_for('/js/gallery.js') %>" defer></script><% } %>
</head>
<body class="<%= is_home() ? 'page-home' : 'page-inner' %>">
  <div class="aurora-bg" aria-hidden="true"><span></span><span></span><span></span><span class="aurora-pointer"></span></div>
  <canvas class="ambient-canvas" aria-hidden="true"></canvas>
  <a class="skip-link" href="#main">跳到正文</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="<%= url_for('/') %>" aria-label="<%= config.title %>"><span class="brand-mark<%= theme.avatar ? ' has-avatar' : '' %>" aria-hidden="true"><% if (theme.avatar) { %><img class="brand-avatar" src="<%= url_for(theme.avatar) %>" alt=""><% } else { %>D.<% } %></span><span>DuLuo.</span></a>
      <% const readingNow = is_archive() || is_post() || page.taxonomy_kind === 'category' || page.taxonomy_kind === 'tag'; %>
      <nav aria-label="主导航">
        <a data-magnetic href="<%= url_for('/') %>"<%- is_home() ? ' aria-current="page"' : '' %>>首页</a>
        <a data-magnetic href="<%= url_for('/archives/') %>"<%- readingNow ? ' aria-current="page"' : '' %>>文章</a>
        <a data-magnetic href="<%= url_for('/projects/') %>"<%- page.path === 'projects/index.html' ? ' aria-current="page"' : '' %>>项目</a>
        <a data-magnetic href="<%= url_for('/share/') %>"<%- page.path === 'share/index.html' ? ' aria-current="page"' : '' %>>资源</a>
        <a data-magnetic href="<%= url_for('/bloggers/') %>"<%- page.path === 'bloggers/index.html' ? ' aria-current="page"' : '' %>>友链</a>
        <a data-magnetic href="<%= url_for('/about/') %>"<%- page.path === 'about/index.html' ? ' aria-current="page"' : '' %>>关于</a>
      </nav>
      <button class="search-trigger" data-magnetic type="button" data-search-open hidden aria-haspopup="dialog" aria-controls="site-search" aria-label="搜索"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><kbd>Ctrl K</kbd></button>
    </div>
  </header>
  <% if (is_post()) { %><div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div><% } %>
  <main id="main" class="wrapper"><%- body %></main>
  <footer class="site-footer wrapper">
    <div><a class="footer-brand" href="<%= url_for('/') %>">DuLuo.</a><span class="footer-note"><%= theme.footer_note %></span></div>
    <div>© <%= date(new Date(), 'YYYY') %> <%= config.author %> · <a href="https://hexo.io/" target="_blank" rel="noopener noreferrer">Hexo</a><span class="footer-divider">/</span><% const githubHref = journal_github_url(); if (githubHref) { %><a href="<%= githubHref %>" target="_blank" rel="noopener noreferrer">GitHub ↗</a><% } else { %>GitHub<% } %></div>
  </footer>
  <dialog id="site-search" class="search-dialog" data-search-url="<%= url_for('/search.json') %>" aria-labelledby="search-title">
    <div class="search-heading"><h2 id="search-title">搜索</h2><button type="button" data-search-close aria-label="关闭搜索">✕</button></div>
    <label class="sr-only" for="search-input">搜索标题、正文或标签</label>
    <input id="search-input" type="search" placeholder="关键词…" autocomplete="off" maxlength="120" autofocus>
    <p class="search-status" role="status" aria-live="polite">键入关键词…</p>
    <button class="search-retry" type="button" hidden>重新加载</button>
    <ul class="search-results" aria-label="搜索结果"></ul>
    <div class="search-hint"><span>支持中文 · 多个关键词用空格分隔</span><span><kbd>Esc</kbd> 关闭</span></div>
  </dialog>
</body>
</html>
