<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% const currentTitle = is_home() ? config.title : ((page.title || (is_archive() ? '文章归档' : config.title)) + ' · ' + config.title); %>
  <% const summary = page.description || config.description; %>
  <title><%= currentTitle %></title>
  <meta name="description" content="<%= summary %>">
  <meta name="author" content="<%= config.author %>">
  <meta name="theme-color" content="#f3f8fc">
  <% if (config.preview_build || page.path === '404.html') { %><meta name="robots" content="noindex, nofollow"><% } %>
  <link rel="canonical" href="<%= full_url_for(page.path || '') %>">
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= currentTitle %>">
  <meta property="og:description" content="<%= summary %>">
  <meta property="og:url" content="<%= full_url_for(page.path || '') %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:locale" content="zh_CN">
  <link rel="icon" type="image/svg+xml" href="<%= url_for('/favicon.svg') %>">
  <link rel="stylesheet" href="<%= url_for('/css/style.css') %>">
  <script src="<%= url_for('/js/site.js') %>" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">跳到正文</a>
  <header class="site-header">
    <div class="wrapper header-inner">
      <a class="brand" href="<%= url_for('/') %>" aria-label="<%= config.title %>首页"><span class="brand-mark" aria-hidden="true">D<span>·</span></span><span>DuLuo<span class="brand-note">的小栈</span></span></a>
      <nav aria-label="主导航">
        <a href="<%= url_for('/') %>"<%- is_home() ? ' aria-current="page"' : '' %>>首页</a>
        <a href="<%= url_for('/archives/') %>"<%- is_archive() ? ' aria-current="page"' : '' %>>归档</a>
        <a href="<%= url_for('/categories/') %>"<%- page.taxonomy_kind === 'category' ? ' aria-current="page"' : '' %>>分类</a>
        <a href="<%= url_for('/tags/') %>"<%- page.taxonomy_kind === 'tag' ? ' aria-current="page"' : '' %>>标签</a>
        <a href="<%= url_for('/about/') %>"<%- page.path === 'about/index.html' ? ' aria-current="page"' : '' %>>关于我</a>
      </nav>
      <button class="search-trigger" type="button" data-search-open hidden aria-haspopup="dialog" aria-controls="site-search"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>搜索</span><kbd>Ctrl K</kbd></button>
    </div>
  </header>
  <% if (is_post()) { %><div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div><% } %>
  <main id="main" class="wrapper"><%- body %></main>
  <footer class="site-footer wrapper">
    <div><a class="footer-brand" href="<%= url_for('/') %>">DuLuo 的小栈</a><span class="footer-note"><%= theme.footer_note %></span></div>
    <div>© <%= date(new Date(), 'YYYY') %> <%= config.author %> · <a href="https://hexo.io/" target="_blank" rel="noopener noreferrer">Hexo</a><span class="footer-divider">/</span><a href="<%= theme.github_url %>" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
  </footer>
  <dialog id="site-search" class="search-dialog" data-search-url="<%= url_for('/search.json') %>" aria-labelledby="search-title">
    <div class="search-heading"><h2 id="search-title">寻找一篇记录</h2><button type="button" data-search-close aria-label="关闭搜索">✕</button></div>
    <label class="sr-only" for="search-input">搜索标题、正文或标签</label>
    <input id="search-input" type="search" placeholder="搜索标题、正文或标签…" autocomplete="off" maxlength="120" autofocus>
    <p class="search-status" role="status" aria-live="polite">输入关键词，找回那些灵光一闪。</p>
    <button class="search-retry" type="button" hidden>重新加载</button>
    <ul class="search-results" aria-label="搜索结果"></ul>
    <div class="search-hint"><span>支持中文 · 多个关键词用空格分隔</span><span><kbd>Esc</kbd> 关闭</span></div>
  </dialog>
</body>
</html>
