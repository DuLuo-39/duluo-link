<% const widgets = theme.widgets || {}; const art = theme.artwork; %>
<div class="desktop-heading"><p class="eyebrow"><span class="tiny-star" aria-hidden="true">✦</span> MY LITTLE CORNER OF THE INTERNET</p><a href="#recent-title">去读一篇文章 <span aria-hidden="true">↗</span></a></div>
<div class="desktop-grid">
  <section class="welcome-stack" aria-labelledby="welcome-title">
    <figure class="artwork-card glass">
      <div class="artwork-mat">
        <span class="artwork-lettering" aria-hidden="true"><%= art.name_en %><span>✦</span></span>
        <a class="artwork-link" href="<%= art.source_url %>" target="_blank" rel="noopener noreferrer" aria-label="在 Pixiv 查看《<%= art.title %>》原作">
          <img src="<%= url_for(art.image) %>" alt="<%= art.alt %>" width="<%= art.width %>" height="<%= art.height %>" fetchpriority="high">
        </a>
      </div>
      <figcaption><span><span class="artwork-dot" aria-hidden="true"></span><%= art.character %> <small>· 鸣潮</small></span><a href="<%= art.source_url %>" target="_blank" rel="noopener noreferrer">Illustration by <%= art.artist %> ↗</a></figcaption>
    </figure>
    <div class="greeting-card glass">
      <p class="greeting-kicker"><span aria-hidden="true">✧</span> <span<%- widgets.greeting !== false ? ' data-greeting' : '' %>>很高兴遇见你</span></p>
      <h1 id="welcome-title">嗨，我是 <span><%= config.author %></span><i aria-hidden="true">.</i></h1>
      <p class="welcome-subtitle"><%= theme.hero_title %></p>
      <p class="greeting-description"><%- theme.hero_description %></p>
      <div class="welcome-actions"><a class="primary-link" href="#recent-title">开始阅读 <span aria-hidden="true">↓</span></a><a class="quiet-link" href="<%= theme.github_url %>" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
      <span class="greeting-star" aria-hidden="true">✧</span>
    </div>
  </section>
  <aside class="desktop-widgets" aria-label="桌面小组件">
    <% if (widgets.clock !== false) { %><section class="clock-card glass" aria-labelledby="clock-title"><h2 id="clock-title" class="widget-label"><span class="status-dot" aria-hidden="true"></span>北京时间 <span>UTC+8</span></h2><time data-clock class="clock-digits">--:--</time><p data-clock-date>时间正在路上</p><noscript><p>启用 JavaScript 查看实时时间。</p></noscript></section><% } %>
    <% if (widgets.calendar !== false) { %><section class="calendar-card glass" aria-labelledby="calendar-title"><div class="calendar-heading"><h2 id="calendar-title" data-calendar-title>这一月</h2><span aria-hidden="true">◷</span></div><div data-calendar><p class="muted">日历加载中…</p></div><noscript><p>启用 JavaScript 查看当月日历。</p></noscript></section><% } %>
    <section class="notebook-card glass" aria-labelledby="notebook-title"><p class="widget-label">A FEW THINGS ABOUT ME</p><h2 id="notebook-title">记录，也是成长<span aria-hidden="true">✦</span></h2><p>代码里的小发现，<br>和屏幕外的小日常。</p><div class="profile-stats"><a href="<%= url_for('/archives/') %>"><strong><%= site.posts.length %></strong><span>篇文章</span></a><a href="<%= url_for('/categories/') %>"><strong><%= site.categories.filter(term => term.posts.length > 0).length %></strong><span>个分类</span></a><a href="<%= url_for('/tags/') %>"><strong><%= site.tags.filter(term => term.posts.length > 0).length %></strong><span>个标签</span></a></div><a class="quiet-link" href="<%= url_for('/about/') %>">更多关于我 ↗</a></section>
  </aside>
</div>
<div class="home-columns">
  <section class="posts-section" aria-labelledby="recent-title">
    <div class="section-heading"><h2 id="recent-title">最近更新 <span class="small-english">LATEST NOTES</span></h2><a href="<%= url_for('/archives/') %>">全部文章 ↗</a></div>
    <div class="post-list"><% page.posts.each(function(post) { %><%- partial('_post-card', { post }) %><% }); %></div>
    <% if (!page.posts.length) { %><p class="empty-state">故事正要开始，第一篇笔记很快见。</p><% } %>
    <% if (page.total > 1) { %><nav class="pagination" aria-label="文章分页"><%- paginator({ prev_text: '上一页', next_text: '下一页' }) %></nav><% } %>
  </section>
  <aside class="home-sidebar" aria-label="文章探索">
    <% if (widgets.random_post !== false) { const candidates = site.posts.sort('-date').toArray(); const first = candidates[0]; %>
    <section class="random-card glass" aria-labelledby="random-title" data-random-post data-url="<%= url_for('/recommendations.json') %>">
      <div class="section-heading"><h2 id="random-title">偶遇一篇</h2><span aria-hidden="true"><%- journal_icon('shuffle') %></span></div>
      <div class="random-content" aria-live="polite" aria-atomic="true">
        <% if (first) { %><p class="widget-label" data-random-date><%= date(first.date, 'YYYY.MM.DD') %></p><a class="random-title" data-random-link href="<%= url_for(first.path) %>"><%= first.title %></a><p data-random-description><%= first.description || '打开这篇记录，看看有什么新发现。' %></p><% } else { %><p>第一篇记录，正在路上。</p><% } %>
      </div><button class="shuffle-button" type="button" data-random-next hidden><%- journal_icon('shuffle') %> 换一篇</button><p class="sr-only" role="status" data-random-status></p>
    </section><% } %>
    <section class="sidebar-topics glass"><h2><span aria-hidden="true">#</span> 沿着兴趣探索</h2><div class="tag-list"><% site.tags.sort('name', 1).toArray().filter(tag => tag.posts.length > 0).slice(0, 12).forEach(function(tag) { %><a href="<%= url_for(tag.path) %>"><%= tag.name %></a><% }); %><% if (!site.tags.length) { %><span class="muted">新的关键词，正在路上。</span><% } %></div></section>
  </aside>
</div>
