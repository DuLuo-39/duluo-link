<% const widgets = theme.widgets || {}; const arts = journal_featured_artworks().map(item => Object.assign({}, item, { image: /^https?:\/\//i.test(item.image) ? item.image : url_for(item.image) })); const art = arts[0]; const postCount = site.posts.length; const categoryCount = site.categories.filter(term => term.posts.length > 0).length; const tagCount = site.tags.filter(term => term.posts.length > 0).length; %>
<section class="stage-hero<%= art ? '' : ' is-empty' %>">
  <% if (art) { const credit = art.artist_handle || art.artist; const totalLabel = String(arts.length).padStart(2, '0'); %>
  <figure class="stage-artwork" data-tilt data-artwork<% if (arts.length > 1) { %> data-artwork-switch<% } %>>
    <a class="stage-gallery" data-magnetic href="<%= url_for('/gallery/') %>">Gallery ↗</a>
    <a class="artwork-link" data-artwork-source href="<%= art.source_url || art.image %>" target="_blank" rel="noopener noreferrer" aria-label="查看《<%= art.title || art.character || '插画' %>》原作">
      <img data-artwork-image src="<%= art.image %>" alt="<%= art.alt %>"<% if (art.width) { %> width="<%= art.width %>"<% } %><% if (art.height) { %> height="<%= art.height %>"<% } %> fetchpriority="high">
    </a>
    <figcaption class="artwork-placard">
      <div class="placard-copy">
        <p class="placard-title" data-artwork-title><%= art.title ? ('《' + art.title + '》') : (art.character || '插画') %></p>
        <p class="placard-meta">
          <span data-artwork-character><%= art.character || '' %></span><small data-artwork-series-wrap<% if (!art.series) { %> hidden<% } %>> · <span data-artwork-series><%= art.series || '' %></span></small>
          <a data-artwork-artist href="<%= art.artist_url || art.source_url || art.image %>" target="_blank" rel="noopener noreferrer"><%= credit ? (credit + ' ↗') : '原作 ↗' %></a>
        </p>
      </div>
      <% if (arts.length > 1) { %>
      <div class="artwork-switch">
        <button type="button" data-magnetic data-artwork-prev aria-label="上一张">‹</button>
        <span data-artwork-index>01 / <%= totalLabel %></span>
        <button type="button" data-magnetic data-artwork-next aria-label="下一张">›</button>
      </div>
      <% } else { %>
      <span class="artwork-index" data-artwork-index>01</span>
      <% } %>
    </figcaption>
    <script type="application/json" data-artwork-data><%- JSON.stringify(arts).replace(/</g, '\\u003c') %></script>
  </figure>
  <% } %>
  <div class="stage-identity">
    <h1>DuLuo.</h1>
    <% if (widgets.greeting !== false) { %><p class="stage-phrase" data-greeting>晨雾未散</p><% } %>
    <% if (widgets.clock !== false || widgets.calendar !== false) { %>
    <div class="stage-time">
      <% if (widgets.clock !== false) { %>
        <% if (widgets.calendar !== false) { %>
        <button class="stage-clock" type="button" data-calendar-toggle aria-expanded="false" aria-controls="stage-calendar">
          <span class="sr-only">北京时间，展开或收起日历</span>
        <% } else { %>
        <div class="stage-clock">
        <% } %>
          <time data-clock class="stage-digits"><span class="clock-main">--:--</span><span class="clock-sec">:--</span></time>
          <span><span data-clock-date>时间正在路上</span><span class="clock-zone">UTC+8</span></span>
        <% if (widgets.calendar !== false) { %></button><% } else { %></div><% } %>
        <noscript><p>启用 JavaScript 查看实时时间。</p></noscript>
      <% } %>
      <% if (widgets.calendar !== false) { %>
      <div id="stage-calendar" class="stage-calendar"<% if (widgets.clock !== false) { %> hidden<% } %>>
        <p class="stage-calendar-title" data-calendar-title>这一月</p>
        <div data-calendar><p class="muted">日历加载中…</p></div>
        <noscript><p>启用 JavaScript 查看当月日历。</p></noscript>
      </div>
      <% } %>
    </div>
    <% } %>
    <% if (widgets.music !== false) { const tracks = journal_music_tracks(); const published = tracks.map(track => ({ title: track.title, artist: track.artist, src: /^https?:\/\//i.test(track.src) ? track.src : url_for(track.src) })); %>
    <section class="stage-music<%= published.length ? '' : ' is-quiet' %>" data-music-player aria-label="背景音乐">
      <% if (!published.length) { %>
      <span class="vinyl" aria-hidden="true"></span>
      <p class="music-empty">BGM · 静音</p>
      <% } else { %>
      <span class="disc" aria-hidden="true"><span class="vinyl"></span><span class="eq"><i></i><i></i><i></i><i></i></span></span>
      <div class="music-copy">
        <p class="music-track" data-music-title><%= published[0].title %></p>
        <p class="music-artist" data-music-artist><%= published[0].artist || '未署名' %></p>
        <p class="music-time"><span data-music-current>00:00</span> / <span data-music-duration>00:00</span></p>
      </div>
      <div class="music-controls">
        <button type="button" data-music-prev aria-label="上一首"<% if (published.length < 2) { %> disabled<% } %>>‹</button>
        <button type="button" data-music-toggle aria-pressed="false" aria-label="播放">▶</button>
        <button type="button" data-music-next aria-label="下一首"<% if (published.length < 2) { %> disabled<% } %>>›</button>
      </div>
      <label class="sr-only" for="music-progress">播放进度</label>
      <input id="music-progress" class="music-progress" type="range" min="0" max="1000" value="0" step="1" data-music-progress>
      <p class="music-error" data-music-error role="status" hidden>这首暂时播不了，可以换一首或稍后再试。</p>
      <audio data-music-audio preload="none" src="<%= published[0].src %>"></audio>
      <script type="application/json" data-music-tracks><%- JSON.stringify(published).replace(/</g, '\\u003c') %></script>
      <% } %>
      <noscript><p>启用 JavaScript 后可以播放本地音乐。</p></noscript>
    </section>
    <% } %>
    <div class="stage-socials"><%- journal_social_bar() %></div>
    <p class="stage-coords">
      <a href="<%= url_for('/archives/') %>"><strong><%= postCount %></strong> 文章</a>
      <a href="<%= url_for('/categories/') %>"><strong><%= categoryCount %></strong> 分类</a>
      <a href="<%= url_for('/tags/') %>"><strong><%= tagCount %></strong> 标签</a>
    </p>
  </div>
</section>
<div class="stage-flow">
  <section class="stage-notes" aria-labelledby="recent-title">
    <div class="section-heading"><h2 id="recent-title">近期文章</h2><a href="<%= url_for('/archives/') %>">全部 ↗</a></div>
    <% if (page.posts.length) { %>
    <div class="note-list">
      <% page.posts.each(function(post) { const category = post.categories.length ? post.categories.toArray().at(-1) : null; %>
      <article class="note-row" data-reveal>
        <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY.MM.DD') %></time>
        <h3><a href="<%= url_for(post.path) %>"><%= post.title %> <span aria-hidden="true">↗</span></a></h3>
        <% if (category) { %><a class="category-label" href="<%= url_for(category.path) %>"><%= category.name %></a><% } %>
        <p><%= post.description || truncate(strip_html(post.excerpt || post.content), { length: 72 }) %></p>
      </article>
      <% }); %>
    </div>
    <% } else { %>
    <p class="empty-state">尚无笔记。</p>
    <% } %>
    <% if (page.total > 1) { %><nav class="pagination" aria-label="文章分页"><%- paginator({ prev_text: '上一页', next_text: '下一页' }) %></nav><% } %>
  </section>
  <aside class="stage-side" aria-label="漫游">
    <% if (widgets.random_post !== false) { const candidates = site.posts.sort('-date').toArray(); const first = candidates[0]; %>
    <section class="random-card" aria-labelledby="random-title" data-random-post data-url="<%= url_for('/recommendations.json') %>">
      <div class="section-heading"><h2 id="random-title">偶遇一篇</h2></div>
      <div class="random-content" aria-live="polite" aria-atomic="true">
        <% if (first) { %><p class="widget-label" data-random-date><%= date(first.date, 'YYYY.MM.DD') %></p><a class="random-title" data-random-link href="<%= url_for(first.path) %>"><%= first.title %></a><p data-random-description><%= first.description || '打开这篇记录，看看有什么新发现。' %></p><% } else { %><p>第一篇记录，正在路上。</p><% } %>
      </div>
      <button class="shuffle-button" type="button" data-random-next hidden><%- journal_icon('shuffle') %> 换一篇</button>
      <p class="sr-only" role="status" data-random-status></p>
    </section>
    <% } %>
    <section class="stage-stardust" aria-labelledby="stardust-title">
      <h2 id="stardust-title">关键词</h2>
      <div class="tag-list"><% site.tags.sort('name', 1).toArray().filter(tag => tag.posts.length > 0).slice(0, 12).forEach(function(tag) { %><a href="<%= url_for(tag.path) %>"><%= tag.name %></a><% }); %><% if (!site.tags.length) { %><span class="muted">尚无关键词。</span><% } %></div>
      <p class="stardust-more"><a href="<%= url_for('/tags/') %>">标签 ↗</a><a href="<%= url_for('/categories/') %>">分类 ↗</a></p>
    </section>
    <nav class="stage-roam" aria-label="快捷漫游">
      <a href="<%= url_for('/gallery/') %>">画廊 <span aria-hidden="true">↗</span></a>
      <a href="<%= url_for('/share/') %>">资源 <span aria-hidden="true">↗</span></a>
      <a href="<%= url_for('/projects/') %>">项目 <span aria-hidden="true">↗</span></a>
    </nav>
  </aside>
</div>
