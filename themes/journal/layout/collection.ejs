<section class="directory-page collection-page"><header class="archive-header"><a class="back-link" href="<%= url_for(page.taxonomy_kind === 'category' ? '/categories/' : '/tags/') %>">← 所有<%= page.taxonomy_kind === 'category' ? '分类' : '标签' %></a><p class="eyebrow"><%= page.taxonomy_kind === 'category' ? 'TOPIC' : 'TAG' %> · <%= page.posts.length %> 篇记录</p><h1><%= page.term_name %></h1></header><div class="post-list"><% page.posts.each(function(post) { %><%- partial('_post-card', { post }) %><% }); %></div></section>
