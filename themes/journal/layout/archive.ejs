<section class="archive-page"><header class="archive-header"><p class="eyebrow">THE ARCHIVE</p><h1>文章归档</h1><p>一些发现，一些思考，都留在这里。</p></header><% let lastYear = ''; %><% page.posts.each(function(post) { const year = date(post.date, 'YYYY'); %><% if (year !== lastYear) { lastYear = year; %><h2 class="archive-year"><%= year %></h2><% } %><article class="archive-row"><time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'MM.DD') %></time><h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3><span aria-hidden="true">↗</span></article><% }); %><% if (!page.posts.length) { %><p>第一篇记录，很快见。</p><% } %><% if (page.total > 1) { %><nav class="pagination" aria-label="归档分页"><%- paginator({ prev_text: '上一页', next_text: '下一页' }) %></nav><% } %></section>
